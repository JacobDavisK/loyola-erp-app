# ── Runtime mode ────────────────────────────────────────────────
# "development" enables the demo role selector. It is ALWAYS disabled when NODE_ENV=production.
EXAMCORE_DEMO_MODE=true

# ── Database ────────────────────────────────────────────────────
# Local development uses the bundled PostgreSQL (npm run db:start).
DATABASE_URL="postgresql://examcore:examcore_dev@localhost:54329/examcore"
LOCAL_PG_PORT=54329
LOCAL_PG_PASSWORD=examcore_dev

# ── Security ────────────────────────────────────────────────────
# 32+ random bytes. Used to sign file download URLs.
APP_SECRET="replace-with-32-random-bytes-base64url"
# 32 random bytes, base64. Encrypts MFA secrets and stored exam files (AES-256-GCM).
DATA_ENCRYPTION_KEY="replace-with-32-random-bytes-base64"
APP_URL="http://localhost:3100"

# ── Storage ─────────────────────────────────────────────────────
# "local" stores encrypted files in STORAGE_DIR (outside /public). Swap the adapter for S3/GCS/Azure in production.
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# ── E-mail ──────────────────────────────────────────────────────
# "outbox" keeps messages in the EmailOutbox table (development). Implement an SMTP/provider adapter for production.
EMAIL_DRIVER=outbox
EMAIL_FROM="EXAMCORE <examcell@example.edu>"

# ── PDF ─────────────────────────────────────────────────────────
# Optional path to a Chromium/Chrome executable. Defaults to Playwright's bundled Chromium.
CHROMIUM_PATH=

# ── Online payments ─────────────────────────────────────────────
# "none" disables online payment (counter collections still work). "razorpay" needs the three keys below.
# Payment status is always verified server-side with the gateway; the browser is never trusted.
PAYMENT_GATEWAY=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI assistance (optional). Off unless configured; nothing is simulated. ──
# Prompts are redacted of obvious identifiers; only usage metadata is logged.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5
