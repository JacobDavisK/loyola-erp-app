// ───────────────────────── Verifiable digital credentials (W3C VC 2.0 / Open Badges 3.0), badges,
//                            micro-credentials, the comprehensive learner record and sharing ─────────────────────────

/// Ed25519 keys the institution signs verifiable credentials with (published in its did:web document).
model SigningKey {
  id         String   @id @default(cuid())
  purpose    String
  kid        String   @unique
  privateKey String
  publicJwk  Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([purpose, active])
}

enum BadgeKind {
  BADGE
  MICRO_CREDENTIAL
  CERTIFICATE_OF_PARTICIPATION
}

/// An achievement students can earn (Open Badges "Achievement"): a skill badge, a stackable
/// micro-credential with credits, or a participation certificate for an event.
model BadgeClass {
  id          String       @id @default(cuid())
  name        String
  kind        BadgeKind    @default(BADGE)
  description String
  criteria    String
  skills      String[]
  /// Credits a micro-credential carries (may count towards a programme through credit transfer)
  credits     Float?
  /// Hours of learning or participation
  hours       Float?
  departmentId String?
  active      Boolean      @default(true)
  createdById String
  createdAt   DateTime     @default(now())
  awards      BadgeAward[]

  @@index([active])
}

model BadgeAward {
  id          String     @id @default(cuid())
  badgeId     String
  studentId   String
  evidence    String?
  awardedById String
  awardedAt   DateTime   @default(now())
  revokedAt   DateTime?
  revokeReason String?
  badge       BadgeClass @relation(fields: [badgeId], references: [id])
  student     Student    @relation(fields: [studentId], references: [id])

  @@unique([badgeId, studentId])
  @@index([studentId])
}

enum VcKind {
  ACADEMIC
  BADGE
  LEARNER_RECORD
}

/// A signed verifiable credential (VC-JWT, EdDSA). The JWT is what the holder keeps in a wallet.
model VerifiableCredential {
  id                 String    @id @default(cuid())
  kind               VcKind
  studentId          String
  issuedCredentialId String?
  badgeAwardId       String?
  jwt                String
  types              String[]
  issuedAt           DateTime  @default(now())
  revokedAt          DateTime?
  student            Student   @relation(fields: [studentId], references: [id])
  shares             CredentialShare[]

  @@index([studentId, kind])
  @@index([issuedCredentialId])
  @@index([badgeAwardId])
}

/// A link the student gives an employer or another institution to view and verify a credential.
model CredentialShare {
  id           String               @id @default(cuid())
  vcId         String
  tokenHash    String               @unique
  label        String?
  expiresAt    DateTime
  views        Int                  @default(0)
  lastViewedAt DateTime?
  revokedAt    DateTime?
  createdAt    DateTime             @default(now())
  vc           VerifiableCredential @relation(fields: [vcId], references: [id], onDelete: Cascade)

  @@index([vcId])
}
