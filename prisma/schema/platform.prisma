// ───────────────────────── Workflow engine ─────────────────────────
// Reusable approval engine for every module except question papers, which keep their dedicated
// state machine (see docs/question-paper-system.md).

enum WorkflowStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
  CANCELLED
}

/// A versioned approval process. `steps` is validated by src/lib/domain/workflow-engine.ts.
/// Instances pin the version they started with, so editing a definition never changes in-flight approvals.
model WorkflowDefinition {
  id          String             @id @default(cuid())
  key         String // e.g. leave.request
  version     Int
  name        String
  module      String
  description String?
  steps       Json
  isActive    Boolean            @default(true)
  createdById String?
  createdAt   DateTime           @default(now())
  instances   WorkflowInstance[]

  @@unique([key, version])
  @@index([key, isActive])
}

model WorkflowInstance {
  id            String             @id @default(cuid())
  definitionId  String
  key           String
  module        String
  resourceType  String
  resourceId    String
  title         String
  summary       String?
  departmentId  String? // subject department: drives approver scope
  subjectUserId String? // person the request is about (e.g. the employee on leave)
  data          Json? // context for step conditions and approver screens
  status        WorkflowStatus     @default(IN_PROGRESS)
  currentStep   Int                @default(0)
  round         Int                @default(1) // incremented on each resubmission
  initiatorId   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  completedAt   DateTime?
  definition    WorkflowDefinition @relation(fields: [definitionId], references: [id])
  initiator     User               @relation("WorkflowInitiator", fields: [initiatorId], references: [id])
  tasks         WorkflowTask[]
  actions       WorkflowAction[]

  @@index([resourceType, resourceId])
  @@index([status, key])
  @@index([initiatorId])
}

model WorkflowTask {
  id              String             @id @default(cuid())
  instanceId      String
  round           Int                @default(1)
  stepIndex       Int
  stepKey         String
  stepName        String
  assigneeId      String
  delegatedFromId String?
  status          WorkflowTaskStatus @default(PENDING)
  comment         String?
  dueAt           DateTime?
  escalatedAt     DateTime?
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())
  instance        WorkflowInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignee        User               @relation("WorkflowAssignee", fields: [assigneeId], references: [id])
  delegatedFrom   User?              @relation("WorkflowDelegatedFrom", fields: [delegatedFromId], references: [id])

  @@index([assigneeId, status])
  @@index([instanceId, round, stepIndex])
  @@index([status, dueAt])
}

/// Append-only history of everything that happened to a workflow instance (DB trigger enforced).
model WorkflowAction {
  id         String           @id @default(cuid())
  instanceId String
  taskId     String?
  actorId    String?
  action     String // start, approve, reject, return, delegate, escalate, cancel, complete, resubmit
  stepIndex  Int?
  comment    String?
  createdAt  DateTime         @default(now())
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor      User?            @relation(fields: [actorId], references: [id])

  @@index([instanceId, createdAt])
}

/// Out-of-office delegation: new tasks for `fromUser` go to `toUser` during the window.
model WorkflowDelegation {
  id         String    @id @default(cuid())
  fromUserId String
  toUserId   String
  module     String? // null = all modules
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  fromUser   User      @relation("DelegationFrom", fields: [fromUserId], references: [id])
  toUser     User      @relation("DelegationTo", fields: [toUserId], references: [id])

  @@index([fromUserId, startsAt, endsAt])
}

// ───────────────────────── Events, jobs & sequences ─────────────────────────

/// Transactional outbox. Written in the same transaction as the change; the worker dispatches handlers.
model DomainEvent {
  id            BigInt    @id @default(autoincrement())
  type          String // StudentAdmitted, PaymentReceived …
  aggregateType String
  aggregateId   String
  payload       Json
  actorId       String?
  occurredAt    DateTime  @default(now())
  processedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([processedAt, id])
  @@index([aggregateType, aggregateId])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Background job queue (bulk imports, exports, PDF generation, notifications). Claimed with SKIP LOCKED.
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(QUEUED)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime?
  lockedBy    String?
  progress    Int       @default(0)
  result      Json?
  error       String?
  createdById String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@index([status, runAt])
  @@index([createdById, createdAt])
}

/// Concurrency-safe document numbering (student ids, invoices, receipts, certificates).
model NumberSequence {
  key       String   @id
  prefix    String   @default("")
  next      Int      @default(1)
  padding   Int      @default(5)
  updatedAt DateTime @updatedAt
}
